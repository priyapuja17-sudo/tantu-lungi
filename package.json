{
  "name": "tantu-lungi-store",
  "version": "1.0.0",
  "private": true,
  "description": "Premium lungi e-commerce store for Bangladesh (zero-dependency Node + SQLite)",
  "engines": { "node": ">=22.5" },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server/index.js",
    "seed": "node --disable-warning=ExperimentalWarning server/seed.js",
    "clear-demo": "node --disable-warning=ExperimentalWarning server/seed.js --clear-demo",
    "dev": "npm run seed && npm start",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.js"
  }
}
