# ---- Server ----
PORT=3000
NODE_ENV=production                 # production = Secure cookies, HSTS, no dev reset tokens, requires admin env below
PUBLIC_URL=https://your-domain.com  # used for sitemap, canonical URLs and payment callbacks
TRUST_PROXY=1                       # set to 1 only when behind a reverse proxy (Nginx/Cloudflare) so rate limits see real IPs
DATABASE_PATH=./data/shop.db        # SQLite file. Put it on a persistent disk/volume and back it up.
UPLOAD_DIR=./uploads                # product images uploaded from the admin panel. Persistent disk/volume too.

# ---- First admin (required in production, used only if no admin exists yet) ----
ADMIN_EMAIL=owner@your-domain.com
ADMIN_PASSWORD=change-me-to-a-long-random-password

# ---- Optional: load the 24 demo products, demo orders and demo reviews on first start ----
# AUTO_SEED_DEMO=1

# ---- bKash tokenized checkout (gateway mode). All five must be set to enable it. UNTESTED against bKash — test in their sandbox first.
# BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
# BKASH_APP_KEY=
# BKASH_APP_SECRET=
# BKASH_USERNAME=
# BKASH_PASSWORD=
# Nagad / Rocket: no gateway adapter yet (needs merchant contract + provider specs). Use manual TrxID mode from Admin > Settings.
